# Multimodal provider credentials. Only the active provider's key is required.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model overrides (defaults in config.py)
KVA_GEMINI_MODEL=gemini-3.5-flash-lite
KVA_OPENAI_MODEL=gpt-4o-mini

# Working directory for frames, grids and batch artefacts
KVA_WORK_DIR=./work

# Optional. Kick chat history works without login; set a bearer token only if
# Kick starts requiring one for the history endpoint.
KVA_KICK_AUTH_TOKEN=
KVA_KICK_CHAT_WORKERS=8
